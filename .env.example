# rtsp-smart configuration template.
#
# Copy this file to .env and adjust the values:
#   Windows:   copy .env.example .env
#   Linux/mac: cp .env.example .env
#
# Every key is optional except RTSP_STREAM — anything left unset uses the
# default value shown next to the key.

# --- Camera ---------------------------------------------------------------
# RTSP URL of the camera (H.264). Legacy aliases RTSP_STRAM / RTSP_URL also work.
RTSP_STREAM=rtsp://user:password@192.0.2.100:554/stream1

# Camera name, used in screenshot file names.
RTSP_NAME=RTSP

# RTSP transport: tcp = reliable; udp = lower latency but can drop frames.
RTSP_TRANSPORT=tcp

# --- Detection ------------------------------------------------------------
# YOLO model: yolo26n.pt (default) / yolo26s.pt / yolo26m.pt (more accurate, slower).
MODEL=yolo26n.pt

# Compute device: auto = NVIDIA GPU if available, else CPU; also cpu, cuda:0.
DEVICE=auto

# Comma-separated COCO classes to detect, e.g. person,dog
TRIGGER_CLASS=person

# Minimum confidence of a trigger object to save a screenshot (0.0-1.0).
CONFIDENCE_THRESHOLD=0.90

# Analysed region x1,y1,x2,y2 in % of the frame, from the top-left corner.
# 0,0,100,100 = full frame. The crop width rounds up to a multiple of 16.
ACTIVE_WINDOW=0,0,100,100

# --- Pacing / output ------------------------------------------------------
# Seconds between screenshots while a trigger object is visible; during
# this cooldown no frame is analysed (nothing could be saved anyway).
SAVE_INTERVAL_SECONDS=1.0

# Frames analysed per second (lower = less CPU).
DETECT_FPS=5

# Seconds between one-line status log entries.
STAT_INTERVAL_SECONDS=60

# Screenshot folder — relative to the project or absolute (e.g. another disk).
SAVE_DIR=screenshots

# Draw YOLO boxes on saved screenshots (true / false).
DRAW_BOXES=false

# Log file.
LOG_FILE=logs/service.log